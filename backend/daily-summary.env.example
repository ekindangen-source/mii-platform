# Enable the scheduled email.
DAILY_SUMMARY_ENABLED=true

# Default: every day at 18:00 WIB.
DAILY_SUMMARY_CRON=0 18 * * *
DAILY_SUMMARY_TIMEZONE=Asia/Jakarta

# One or more recipients separated by commas.
DAILY_SUMMARY_TO=recipient@example.com

# Generic SMTP configuration.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sender@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="MII Platform <sender@example.com>"
